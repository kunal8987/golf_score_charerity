{
  "name": "digital-heroes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Heroes backend: API gateway + microservices",
  "workspaces": [
    "shared",
    "gateway",
    "services/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev -w gateway",
    "dev:auth": "npm run dev -w services/auth",
    "dev:subscription": "npm run dev -w services/subscription",
    "dev:score": "npm run dev -w services/score",
    "dev:charity": "npm run dev -w services/charity",
    "dev:draw": "npm run dev -w services/draw",
    "dev:winner": "npm run dev -w services/winner",
    "test": "jest --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
